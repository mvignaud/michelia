# Sécurité, sur toutes les pages : HTTPS imposé, pas d'affichage de michel.beer dans le cadre d'un
# autre site (le comptoir ne se fait pas piéger en iframe), adresse complète jamais envoyée aux
# sites tiers (jeton de désabonnement), ni micro ni position. Seule exception au cadre : Stancer,
# qui recharge /comptoir?merci=… dans son iframe de paiement après le 3D Secure. Pas de
# X-Frame-Options : il ne sait pas dire « nous et Stancer », et frame-ancestors le remplace.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://payment.stancer.com
  Permissions-Policy: geolocation=(), microphone=()

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# Le comptoir, où l'on tape sa carte : seuls nos scripts, Turnstile et Stripe (repli) s'y exécutent,
# et les cadres restent ouverts à tout https: : le 3D Secure navigue de payment.stancer.com vers la
# page de la banque DANS le même cadre, et frame-src s'applique à chaque navigation du cadre. Aucun
# autre script tiers ne peut lire les champs de carte (PCI DSS 6.4.3). Cette CSP s'ajoute à celle de /* (frame-ancestors).
/comptoir
  Content-Security-Policy: script-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com; frame-src 'self' https:; object-src 'none'; base-uri 'self'

# La cotisation MichelIA+, où l'on tape aussi sa carte : mêmes règles, sans Stripe.
/la-cotisation
  Content-Security-Policy: script-src 'self' https://challenges.cloudflare.com; frame-src 'self' https:; object-src 'none'; base-uri 'self'

# Les causettes partagées se partagent, elles ne se cherchent pas : jamais dans les moteurs de recherche.
/la-causette/*
  X-Robots-Tag: noindex, nofollow
