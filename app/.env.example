# Copier en .env et remplir avec les valeurs du projet Supabase (Paramètres > API).
# Ces valeurs sont publiques par nature : elles finissent dans l'appli.
# Ne jamais mettre ici la clé service_role ni la clé Anthropic.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
