{
  "expo": {
    "name": "MichelIA",
    "slug": "michel-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "beer.michel.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A2E1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "beer.michel.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "MichelIA",
      "lang": "fr"
    },
    "scheme": "michelia",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7A2E1D",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#5E2214"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Michel a besoin de tes photos pour voir ce que tu veux lui montrer.",
          "cameraPermission": "Michel a besoin de l'appareil photo pour voir ce que tu veux lui montrer.",
          "microphonePermission": "Michel a besoin du micro pour t'entendre quand tu lui parles."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#7A2E1D",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Michel a besoin du micro pour t'entendre quand tu lui parles.",
          "speechRecognitionPermission": "Michel a besoin de la reconnaissance vocale pour écrire ce que tu lui dis."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "071f33b5-c576-4db2-bc57-cdf39a04e048"
      }
    }
  }
}
